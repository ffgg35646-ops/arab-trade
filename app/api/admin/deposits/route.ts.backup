import { NextRequest, NextResponse } from "next/server";
import { promises as fs } from "fs";
import path from "path";

import { connectDB } from "@/lib/mongodb";
import { requireAdminLeader } from "@/lib/admin-auth";

import DepositRequest from "@/models/DepositRequest";
import Wallet from "@/models/Wallet";
import LedgerEntry from "@/models/LedgerEntry";
import Notification from "@/models/Notification";

export async function GET(
  request: NextRequest
) {
  try {
    await connectDB();

    const admin =
      await requireAdminLeader(request);

    if (!admin) {
      return NextResponse.json(
        {
          success: false,
          message: "غير مصرح",
        },
        { status: 403 }
      );
    }

    const url =
      new URL(request.url);

    const status =
      String(
        url.searchParams.get("status") ||
          ""
      ).trim();

    const limit = Math.min(
      Math.max(
        Number(
          url.searchParams.get("limit") ||
            100
        ),
        1
      ),
      500
    );

    const filter: Record<
      string,
      unknown
    > = {};

    if (status) {
      filter.status = status;
    }

    const deposits =
      await DepositRequest.find(
        filter
      )
        .sort({
          createdAt: -1,
        })
        .limit(limit)
        .populate(
          "userId",
          "name username email"
        )
        .lean();

    return NextResponse.json({
      success: true,
      deposits,
    });
  } catch (error) {
    console.error(
      "ADMIN DEPOSITS GET:",
      error
    );

    return NextResponse.json(
      {
        success: false,
        message:
          "تعذر تحميل الإيداعات",
      },
      { status: 500 }
    );
  }
}

export async function PATCH(
  request: NextRequest
) {
  try {
    await connectDB();

    const admin =
      await requireAdminLeader(request);

    if (!admin) {
      return NextResponse.json(
        {
          success: false,
          message: "غير مصرح",
        },
        { status: 403 }
      );
    }

    const body =
      await request.json().catch(
        () => ({})
      );

    const id =
      String(body.id || "").trim();

    const status =
      String(
        body.status || ""
      ).trim();

    const adminNote =
      String(
        body.adminNote || ""
      ).trim();

    if (
      !id ||
      !["approved", "rejected"].includes(
        status
      )
    ) {
      return NextResponse.json(
        {
          success: false,
          message:
            "بيانات غير صحيحة",
        },
        { status: 400 }
      );
    }

    const deposit =
      await DepositRequest.findById(
        id
      );

    if (!deposit) {
      return NextResponse.json(
        {
          success: false,
          message:
            "الإيداع غير موجود",
        },
        { status: 404 }
      );
    }

    if (
      deposit.status !==
      "pending"
    ) {
      return NextResponse.json(
        {
          success: false,
          message:
            "تمت معالجة الطلب مسبقًا",
        },
        { status: 409 }
      );
    }

    const amount =
      Number(deposit.amount);

    if (
      !Number.isFinite(amount) ||
      amount <= 0
    ) {
      return NextResponse.json(
        {
          success: false,
          message:
            "قيمة الإيداع غير صحيحة",
        },
        { status: 400 }
      );
    }

    if (status === "approved") {
      let wallet =
        await Wallet.findOne({
          userId:
            deposit.userId,
          type: "spot",
        });

      if (!wallet) {
        wallet =
          new Wallet({
            userId:
              deposit.userId,
            type: "spot",
            balances: [],
          });
      }

      const asset =
        String(
          deposit.asset
        )
          .trim()
          .toUpperCase();

      let balance =
        wallet.balances.find(
          (b: any) =>
            String(b.asset)
              .toUpperCase() ===
            asset
        );

      let before = 0;

      if (!balance) {
        wallet.balances.push({
          asset,
          available: amount,
          locked: 0,
        });

        balance =
          wallet.balances[
            wallet.balances.length - 1
          ] as any;
      } else {
        before =
          Number(
            balance.available ||
              0
          );

        balance.available =
          before + amount;
      }

      const after =
        Number(
          balance.available ||
            amount
        );

      await wallet.save();

      await LedgerEntry.create({
        userId:
          deposit.userId,
        asset,
        type: "deposit",
        amount,
        balanceBefore: before,
        balanceAfter: after,
        referenceId:
          String(deposit._id),
        note:
          adminNote ||
          `اعتماد إيداع ${deposit.network}`,
      });
    }

    deposit.status =
      status as
        | "approved"
        | "rejected";

    deposit.adminNote =
      adminNote;

    await deposit.save();

    await Notification.create({
      userId:
        deposit.userId,
      type: "deposit",
      title:
        status === "approved"
          ? "تم اعتماد الإيداع"
          : "تم رفض الإيداع",
      message:
        adminNote ||
        (status === "approved"
          ? "تمت إضافة قيمة الإيداع إلى محفظتك"
          : "تم رفض طلب الإيداع"),
      read: false,
    });

    if (
      deposit.screenshotPath
    ) {
      const root =
        path.resolve(
          process.cwd(),
          "private",
          "deposits"
        );

      const absolute =
        path.resolve(
          process.cwd(),
          deposit.screenshotPath
        );

      if (
        absolute.startsWith(
          root + path.sep
        )
      ) {
        await fs.rm(
          path.dirname(
            absolute
          ),
          {
            recursive: true,
            force: true,
          }
        ).catch(() => {});
      }

      deposit.screenshotPath =
        "";

      await deposit.save();
    }

    return NextResponse.json({
      success: true,
      deposit,
    });
  } catch (error) {
    console.error(
      "ADMIN DEPOSITS PATCH:",
      error
    );

    return NextResponse.json(
      {
        success: false,
        message:
          "تعذر تحديث الإيداع",
      },
      { status: 500 }
    );
  }
}

"use client";

import Link from "next/link";
import {
  ArrowDownLeft,
  ArrowUpRight,
  ExternalLink,
  RefreshCw,
  Search,
  SlidersHorizontal,
  X,
} from "lucide-react";
import { useCallback, useEffect, useMemo, useState } from "react";

import InternalNavbar from "@/components/InternalNavbar";
import InternalSidebar from "@/components/InternalSidebar";

type Tab =
  | "open"
  | "history"
  | "trades";

type MarketType =
  | "all"
  | "spot"
  | "margin"
  | "futures";

type Side =
  | "all"
  | "buy"
  | "sell";

interface Order {
  _id?: string;
  id?: string;

  symbol?: string;
  pair?: string;

  side?: string;
  type?: string;
  orderType?: string;
  market?: string;
  marketType?: string;

  price?: number | string | null;
  quantity?: number | string | null;
  qty?: number | string | null;

  executedQty?: number | string | null;
  filledQty?: number | string | null;

  originalQuantity?: number | string | null;
  filledQuantity?: number | string | null;
  remainingQuantity?: number | string | null;
  fillPercent?: number | string | null;

  leverage?: number | string | null;
  marginMode?: string;
  reduceOnly?: boolean;

  avgPrice?: number | string | null;
  averagePrice?: number | string | null;

  status?: string;

  createdAt?: string;
  updatedAt?: string;

  fee?: number | string | null;
  feeAsset?: string;

  total?: number | string | null;

  clientOrderId?: string;
  orderId?: string;

  timeInForce?: string;
}

interface Trade {
  _id?: string;
  id?: string;

  symbol?: string;
  pair?: string;

  side?: string;

  price?: number | string | null;
  quantity?: number | string | null;
  qty?: number | string | null;

  fee?: number | string | null;
  feeAsset?: string;

  realizedPnl?: number | string | null;
  pnl?: number | string | null;

  createdAt?: string;

  orderId?: string;
  tradeId?: string;

  buyOrderId?: string;
  sellOrderId?: string;
  buyerId?: string;
  sellerId?: string;

  feeBuyer?: number | string | null;
  feeSeller?: number | string | null;
  buyerFeeAsset?: string;
  sellerFeeAsset?: string;

  role?: "buyer" | "seller";
  userOrderId?: string;
  counterOrderId?: string;
}

interface OrdersResponse {
  success?: boolean;
  data?: unknown;
  orders?: unknown;
}

interface TradesResponse {
  success?: boolean;
  data?: unknown;
  trades?: unknown;
}

function toArray<T>(
  value: unknown
): T[] {
  if (Array.isArray(value)) {
    return value as T[];
  }

  if (
    value &&
    typeof value === "object"
  ) {
    const obj = value as Record<
      string,
      unknown
    >;

    if (Array.isArray(obj.items)) {
      return obj.items as T[];
    }

    if (Array.isArray(obj.results)) {
      return obj.results as T[];
    }

    if (Array.isArray(obj.data)) {
      return obj.data as T[];
    }

    if (Array.isArray(obj.orders)) {
      return obj.orders as T[];
    }

    if (Array.isArray(obj.trades)) {
      return obj.trades as T[];
    }
  }

  return [];
}

function normalizeSide(
  value: unknown
): "buy" | "sell" | "unknown" {
  const side = String(
    value ?? ""
  )
    .trim()
    .toLowerCase();

  if (
    side === "buy" ||
    side === "long"
  ) {
    return "buy";
  }

  if (
    side === "sell" ||
    side === "short"
  ) {
    return "sell";
  }

  return "unknown";
}

function normalizeStatus(
  value: unknown
): string {
  return String(
    value ?? ""
  )
    .trim()
    .toLowerCase();
}

function normalizeMarket(
  item: Order
): MarketType {
  const value = String(
    item.marketType ??
      item.market ??
      ""
  )
    .trim()
    .toLowerCase();

  if (
    value.includes("future")
  ) {
    return "futures";
  }

  if (
    value.includes("margin")
  ) {
    return "margin";
  }

  return "spot";
}

function getId(
  item: Order | Trade
): string {
  const value = item._id ?? item.id ?? item.orderId;

  if (value !== undefined && value !== null) {
    return String(value);
  }

  if ("tradeId" in item && item.tradeId) {
    return String(item.tradeId);
  }

  return "";
}

function numberValue(
  value: unknown
): number | null {
  if (
    value === null ||
    value === undefined ||
    value === ""
  ) {
    return null;
  }

  const parsed = Number(value);

  return Number.isFinite(parsed)
    ? parsed
    : null;
}

function formatNumber(
  value: unknown,
  maximumFractionDigits = 8
): string {
  const number = numberValue(value);

  if (number === null) {
    return "—";
  }

  return new Intl.NumberFormat(
    "en-US",
    {
      minimumFractionDigits: 0,
      maximumFractionDigits,
    }
  ).format(number);
}

function formatDate(
  value: unknown
): string {
  if (!value) {
    return "—";
  }

  const date = new Date(
    String(value)
  );

  if (
    Number.isNaN(date.getTime())
  ) {
    return "—";
  }

  return new Intl.DateTimeFormat(
    "ar-EG",
    {
      year: "numeric",
      month: "2-digit",
      day: "2-digit",
      hour: "2-digit",
      minute: "2-digit",
      second: "2-digit",
    }
  ).format(date);
}

function getSymbol(
  item: Order | Trade
): string {
  return String(
    (item as Order).symbol ??
      (item as Order).pair ??
      "—"
  ).toUpperCase();
}

function getPrice(
  item: Order | Trade
): number | null {
  return numberValue(
    (item as Order).price
  );
}

function getQuantity(
  item: Order | Trade
): number | null {
  const order = item as Order;

  return numberValue(
    order.remainingQuantity ??
      order.quantity ??
      order.qty
  );
}

function getFilled(
  order: Order
): number | null {
  return numberValue(
    order.filledQuantity ??
      order.executedQty ??
      order.filledQty
  );
}

function getOrderStatusLabel(
  value: unknown
): string {
  const status =
    normalizeStatus(value);

  if (
    status === "open" ||
    status === "new" ||
    status === "pending"
  ) {
    return "مفتوح";
  }

  if (
    status === "filled" ||
    status === "completed" ||
    status === "executed"
  ) {
    return "مكتمل";
  }

  if (
    status === "canceled" ||
    status === "cancelled"
  ) {
    return "ملغي";
  }

  if (
    status === "rejected"
  ) {
    return "مرفوض";
  }

  if (
    status === "partially_filled" ||
    status === "partial"
  ) {
    return "منفذ جزئيًا";
  }

  return value
    ? String(value)
    : "—";
}

function getTypeLabel(
  value: unknown
): string {
  const type =
    String(
      value ?? ""
    )
      .trim()
      .toLowerCase();

  if (
    type === "market"
  ) {
    return "سوق";
  }

  if (
    type === "limit"
  ) {
    return "حد";
  }

  if (
    type === "stop" ||
    type === "stop_limit"
  ) {
    return "إيقاف";
  }

  if (
    type === "stop_market"
  ) {
    return "إيقاف سوق";
  }

  return value
    ? String(value)
    : "—";
}

function SideBadge({
  side,
}: {
  side: unknown;
}) {
  const normalized =
    normalizeSide(side);

  if (
    normalized === "buy"
  ) {
    return (
      <span className="inline-flex items-center gap-1.5 rounded-lg bg-emerald-500/10 px-2.5 py-1 text-xs font-semibold text-emerald-300">
        <ArrowDownLeft size={13} />
        شراء
      </span>
    );
  }

  if (
    normalized === "sell"
  ) {
    return (
      <span className="inline-flex items-center gap-1.5 rounded-lg bg-red-500/10 px-2.5 py-1 text-xs font-semibold text-red-300">
        <ArrowUpRight size={13} />
        بيع
      </span>
    );
  }

  return (
    <span className="rounded-lg bg-white/5 px-2.5 py-1 text-xs text-slate-400">
      —
    </span>
  );
}

function StatusBadge({
  status,
}: {
  status: unknown;
}) {
  const normalized =
    normalizeStatus(status);

  const isOpen =
    normalized === "open" ||
    normalized === "new" ||
    normalized === "pending";

  const isDone =
    normalized === "filled" ||
    normalized === "completed" ||
    normalized === "executed";

  const isCanceled =
    normalized === "canceled" ||
    normalized === "cancelled";

  if (isOpen) {
    return (
      <span className="rounded-lg bg-amber-500/10 px-2.5 py-1 text-xs font-semibold text-amber-300">
        مفتوح
      </span>
    );
  }

  if (isDone) {
    return (
      <span className="rounded-lg bg-emerald-500/10 px-2.5 py-1 text-xs font-semibold text-emerald-300">
        مكتمل
      </span>
    );
  }

  if (isCanceled) {
    return (
      <span className="rounded-lg bg-white/5 px-2.5 py-1 text-xs font-semibold text-slate-400">
        ملغي
      </span>
    );
  }

  if (
    normalized === "rejected"
  ) {
    return (
      <span className="rounded-lg bg-red-500/10 px-2.5 py-1 text-xs font-semibold text-red-300">
        مرفوض
      </span>
    );
  }

  return (
    <span className="rounded-lg bg-white/5 px-2.5 py-1 text-xs text-slate-400">
      {getOrderStatusLabel(status)}
    </span>
  );
}


"use client";

import { useEffect, useMemo, useState } from "react";
import Link from "next/link";
import Navbar from "@/components/Navbar";
import Footer from "@/components/Footer";

type Coin = {
  id: string;
  symbol: string;
  name: string;
  image: string;
  current_price: number;
  price_change_percentage_24h: number | null;
  total_volume: number;
  market_cap: number;
  sparkline_in_7d?: {
    price?: number[];
  };
};

type MarketResponse = {
  coins?: Coin[];
  error?: string;
};

type Category =
  | "all"
  | "volume"
  | "gainers"
  | "losers";

function formatPrice(value: number) {
  if (!Number.isFinite(value)) return "--";

  if (value >= 1000) {
    return value.toLocaleString("en-US", {
      maximumFractionDigits: 2,
    });
  }

  if (value >= 1) {
    return value.toLocaleString("en-US", {
      maximumFractionDigits: 4,
    });
  }

  return value.toLocaleString("en-US", {
    maximumFractionDigits: 8,
  });
}

function formatCompact(value: number) {
  if (!Number.isFinite(value)) return "--";

  return new Intl.NumberFormat("en-US", {
    notation: "compact",
    maximumFractionDigits: 2,
  }).format(value);
}

function MiniChart({ prices }: { prices: number[] }) {
  if (!prices || prices.length < 2) {
    return <div className="h-10 w-24" />;
  }

  const width = 120;
  const height = 40;

  const min = Math.min(...prices);
  const max = Math.max(...prices);
  const range = max - min || 1;

  const points = prices.slice(-40).map((price, index, arr) => {
    const x = (index / (arr.length - 1)) * width;
    const y = height - ((price - min) / range) * (height - 6) - 3;

    return `${x.toFixed(2)},${y.toFixed(2)}`;
  });

  const positive = prices[prices.length - 1] >= prices[0];

  return (
    <svg
      width={width}
      height={height}
      viewBox={`0 0 ${width} ${height}`}
      className="overflow-visible"
    >
      <polyline
        points={points.join(" ")}
        fill="none"
        stroke={positive ? "#22d3ee" : "#ef4444"}
        strokeWidth="1.8"
        strokeLinecap="round"
        strokeLinejoin="round"
      />
    </svg>
  );
}

export default function MarketsPage() {
  const [coins, setCoins] = useState<Coin[]>([]);
  const [search, setSearch] = useState("");
  const [category, setCategory] = useState<Category>("all");
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    let active = true;

    async function loadMarket() {
      try {
        const response = await fetch("/api/market", {
          cache: "no-store",
        });

        if (!response.ok) return;

        const data: MarketResponse = await response.json();

        if (active && Array.isArray(data.coins)) {
          setCoins(data.coins);
        }
      } catch {
        // لا تظهر أخطاء تقنية للمستخدم
      } finally {
        if (active) {
          setLoading(false);
        }
      }
    }

    loadMarket();

    const timer = window.setInterval(loadMarket, 15000);

    return () => {
      active = false;
      window.clearInterval(timer);
    };
  }, []);

  const filteredCoins = useMemo(() => {
    let result = [...coins];

    const q = search.trim().toLowerCase();

    if (q) {
      result = result.filter(
        (coin) =>
          coin.name.toLowerCase().includes(q) ||
          coin.symbol.toLowerCase().includes(q) ||
          coin.id.toLowerCase().includes(q)
      );
    }

    if (category === "volume") {
      result.sort((a, b) => b.total_volume - a.total_volume);
    }

    if (category === "gainers") {
      result.sort(
        (a, b) =>
          (b.price_change_percentage_24h ?? 0) -
          (a.price_change_percentage_24h ?? 0)
      );
    }

    if (category === "losers") {
      result.sort(
        (a, b) =>
          (a.price_change_percentage_24h ?? 0) -
          (b.price_change_percentage_24h ?? 0)
      );
    }

    return result;
  }, [coins, search, category]);

  const marketStats = useMemo(() => {
    const totalVolume = coins.reduce(
      (sum, coin) => sum + (coin.total_volume || 0),
      0
    );

    const totalMarketCap = coins.reduce(
      (sum, coin) => sum + (coin.market_cap || 0),
      0
    );

    const gainers = coins.filter(
      (coin) => (coin.price_change_percentage_24h ?? 0) > 0
    ).length;

    return {
      totalVolume,
      totalMarketCap,
      gainers,
    };
  }, [coins]);

  return (
    <main
      dir="rtl"
      className="min-h-screen bg-[#050a13] text-white"
    >
      <Navbar />

      <section className="relative overflow-hidden">
        <div className="pointer-events-none absolute inset-0 opacity-30">
          <div className="absolute -right-40 top-20 h-96 w-96 rounded-full bg-blue-600/10 blur-3xl" />
          <div className="absolute -left-40 bottom-20 h-96 w-96 rounded-full bg-cyan-400/10 blur-3xl" />

          <div
            className="absolute inset-0"
            style={{
              backgroundImage:
                "linear-gradient(rgba(255,255,255,.025) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.025) 1px, transparent 1px)",
              backgroundSize: "55px 55px",
            }}
          />
        </div>

        <div className="relative mx-auto max-w-[1600px] px-4 py-8 md:px-6">

          <div className="mb-8">
            <div className="mb-3 flex items-center gap-2 text-xs text-cyan-400">
              <span className="h-2 w-2 rounded-full bg-cyan-400 animate-pulse" />
              بيانات السوق
            </div>

            <h1 className="text-3xl font-bold md:text-4xl">
              الأسواق
            </h1>

            <p className="mt-3 max-w-2xl text-sm leading-7 text-slate-500">
              تابع أسعار الأصول الرقمية وحركة الأسواق وحجم التداول
              من خلال بيانات السوق المتاحة.
            </p>
          </div>

          <div className="mb-6 grid gap-3 md:grid-cols-3">

            <div className="rounded-2xl border border-white/10 bg-[#07101d]/90 p-5">
              <div className="text-xs text-slate-500">
                القيمة السوقية
              </div>

              <div className="mt-2 font-mono text-xl font-bold">
                ${formatCompact(marketStats.totalMarketCap)}
              </div>
            </div>

            <div className="rounded-2xl border border-white/10 bg-[#07101d]/90 p-5">
              <div className="text-xs text-slate-500">
                حجم التداول
              </div>

              <div className="mt-2 font-mono text-xl font-bold">
                ${formatCompact(marketStats.totalVolume)}
              </div>
            </div>

            <div className="rounded-2xl border border-white/10 bg-[#07101d]/90 p-5">
              <div className="text-xs text-slate-500">
                العملات المرتفعة
              </div>

              <div className="mt-2 font-mono text-xl font-bold text-emerald-400">
                {marketStats.gainers}
              </div>
            </div>

          </div>

          <div className="overflow-hidden rounded-2xl border border-white/10 bg-[#07101d]/95 shadow-2xl">

            <div className="flex flex-col gap-4 border-b border-white/10 px-5 py-5 md:flex-row md:items-center md:justify-between">

              <div className="flex flex-wrap gap-2">

                <button
                  onClick={() => setCategory("all")}
                  className={`rounded-lg px-4 py-2 text-xs font-semibold transition ${
                    category === "all"
                      ? "bg-blue-500/15 text-cyan-300"
                      : "text-slate-500 hover:bg-white/5 hover:text-slate-200"
                  }`}
                >
                  الكل
                </button>

                <button
                  onClick={() => setCategory("volume")}
                  className={`rounded-lg px-4 py-2 text-xs font-semibold transition ${
                    category === "volume"
                      ? "bg-blue-500/15 text-cyan-300"
                      : "text-slate-500 hover:bg-white/5 hover:text-slate-200"
                  }`}
                >
                  الأكثر تداولًا
                </button>

                <button
                  onClick={() => setCategory("gainers")}
                  className={`rounded-lg px-4 py-2 text-xs font-semibold transition ${
                    category === "gainers"
                      ? "bg-blue-500/15 text-cyan-300"
                      : "text-slate-500 hover:bg-white/5 hover:text-slate-200"
                  }`}
                >
                  الأكثر ارتفاعًا
                </button>

                <button
                  onClick={() => setCategory("losers")}
                  className={`rounded-lg px-4 py-2 text-xs font-semibold transition ${
                    category === "losers"
                      ? "bg-blue-500/15 text-cyan-300"
                      : "text-slate-500 hover:bg-white/5 hover:text-slate-200"
                  }`}
                >
                  الأكثر انخفاضًا
                </button>

              </div>

              <input
                value={search}
                onChange={(e) => setSearch(e.target.value)}
                placeholder="ابحث عن عملة..."
                className="w-full rounded-xl border border-white/10 bg-[#050a13] px-4 py-3 text-sm text-white outline-none placeholder:text-slate-600 focus:border-cyan-400/30 md:w-72"
              />

            </div>

            <div className="overflow-x-auto">

              <div className="min-w-[1050px]">

                <div className="grid grid-cols-[2fr_1.2fr_1fr_1.2fr_1.2fr_1.2fr_1fr] border-b border-white/5 px-5 py-4 text-[11px] text-slate-500">
                  <span>العملة</span>
                  <span>السعر</span>
                  <span>التغير 24 ساعة</span>
                  <span>أعلى 24 ساعة</span>
                  <span>أدنى 24 ساعة</span>
                  <span>حجم التداول</span>
                  <span>الرسم</span>
                </div>

                {loading ? (
                  <div className="px-5 py-20 text-center text-sm text-slate-500">
                    تحميل بيانات السوق...
                  </div>
                ) : filteredCoins.length === 0 ? (
                  <div className="px-5 py-20 text-center text-sm text-slate-500">
                    لم يتم العثور على عملة مطابقة.
                  </div>
                ) : (
                  filteredCoins.map((coin) => {
                    const change =
                      coin.price_change_percentage_24h ?? 0;

                    const positive = change >= 0;

                    const prices =
                      coin.sparkline_in_7d?.price ?? [];

                    const high = prices.length
                      ? Math.max(...prices)
                      : coin.current_price;

                    const low = prices.length
                      ? Math.min(...prices)
                      : coin.current_price;

                    return (
                      <div
                        key={coin.id}
                        className="grid grid-cols-[2fr_1.2fr_1fr_1.2fr_1.2fr_1.2fr_1fr] items-center border-b border-white/5 px-5 py-4 transition hover:bg-white/[0.025]"
                      >

                        <Link
                          href={`/protrade/${coin.symbol.toUpperCase()}_USDT`}
                          className="flex items-center gap-3"
                        >
                          <img
                            src={coin.image}
                            alt=""
                            className="h-9 w-9 rounded-full"
                          />

                          <div>
                            <div className="text-sm font-semibold">
                              {coin.symbol.toUpperCase()}/USDT
                            </div>

                            <div className="mt-1 text-[11px] text-slate-600">
                              {coin.name}
                            </div>
                          </div>
                        </Link>

                        <div className="font-mono text-sm">
                          ${formatPrice(coin.current_price)}
                        </div>

                        <div
                          className={`font-mono text-sm font-semibold ${
                            positive
                              ? "text-emerald-400"
                              : "text-red-400"
                          }`}
                        >
                          {positive ? "+" : ""}
                          {change.toFixed(2)}%
                        </div>

                        <div className="font-mono text-sm text-slate-400">
                          ${formatPrice(high)}
                        </div>

                        <div className="font-mono text-sm text-slate-400">
                          ${formatPrice(low)}
                        </div>

                        <div className="font-mono text-sm text-slate-400">
                          ${formatCompact(coin.total_volume)}
                        </div>

                        <div>
                          <MiniChart prices={prices} />
                        </div>

                      </div>
                    );
                  })
                )}

              </div>

            </div>

          </div>

        </div>
      </section>

      <Footer />
    </main>
  );
}
